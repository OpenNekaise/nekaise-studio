# Nekaise Studio — local configuration. Copy to .env (git-ignored) and fill in.
#   cp .env.example .env
# Training scripts read these via:  set -a; source .env; set +a
# Nothing here is required for the public gsm8k bootstrap experiment.

# ── Teacher backends (only needed when build_data.py / judge calls a frontier teacher) ──
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434     # local models via Ollama (default)

# ── Building pack: THE ONE VAR YOU MUST SET ────────────────────────────────────────────
# The building held out for eval (a folder name under nekaise_data/). If unset, the
# scorer silently falls back to the first folder by name — which can be the WRONG
# building and can leak training data into the exam. Always set it explicitly.
NEKAISE_HOLDOUT=

# ── Optional run knobs (override the defaults in experiments/<exp>/train.py) ───────────
# NEKAISE_BASE_MODEL=unsloth/granite-4.1-3b  # CPT/train another base
# NEKAISE_METHOD=grpo                        # sft | dpo | grpo | cpt
# NEKAISE_DATASET=auto                       # auto = data/LATEST | a dataset id
# NEKAISE_STAGE=grpo                         # output stage name (outputs/<stage>/)
# NEKAISE_INIT_FROM=sft                      # init from a prior stage's checkpoint
# NEKAISE_BUDGET_MIN=60                      # time box per run, minutes

# ── CPT (continued pretraining) knobs ──────────────────────────────────────────────────
# NEKAISE_CPT_EPOCHS=1
# NEKAISE_CPT_LR=2e-5                        # full-parameter LR
# NEKAISE_CPT_LR_LORA=2e-4                   # LoRA LR
# NEKAISE_CPT_FULL=1                         # 1 = full-parameter, 0 = LoRA (gentler)
# NEKAISE_CPT_4BIT=0                         # 1 = QLoRA 4-bit base (big models)
# NEKAISE_CPT_BS=1                           # per-device batch size
# NEKAISE_CPT_SEQ=4096                       # sequence length (lower = less VRAM)

# ── Third metric: nekaise-bench (tools/eval_bench.py) ──────────────────────────────────
# NEKAISE_BENCH_DIR=../nekaise-bench          # local clone of OpenNekaise/nekaise-bench

# ── Dashboard (dashboard-ui/) ──────────────────────────────────────────────────────────
# NEKAISE_DASH_HOSTS=                        # extra allowed hostnames, comma-separated
#                                            # e.g. myhost,.tailXXXX.ts.net (Tailscale)
